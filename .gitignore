*~


# ============================================================
# RE-SHARPER / JETBRAINS TOOLS
# ============================================================

# ReSharper generated files
_ReSharper*/
*.[Rr]e[Ss]harper

# User-specific settings only
*.DotSettings.user

# Team/shared .DotSettings files should normally remain tracked.


# ============================================================
# DOTTRACE / DOTMEMORY / PROFILING
# ============================================================

# JetBrains profiling snapshots
*.dtp
*.dtt
*.dmw

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Generic memory dumps
*.dmp
*.dump

# .NET trace files
*.nettrace

# Performance counters
*.gcdump


# ============================================================
# .NET RUNTIME / DEBUGGING
# ============================================================

# Runtime files
*.pid
*.pid.lock

# Crash dumps
core
core.*

# Symbol caches
symbol-cache/


# ============================================================
# MSBUILD
# ============================================================

# MSBuild binary logs
*.binlog

# MSBuild temporary files
*.cache

# Generated response files
*.rsp.tmp

# Temporary project files
*_wpftmp.csproj


# ============================================================
# SOURCE GENERATORS
# ============================================================

# Source-generator output, if configured to emit files locally
Generated/
generated/

# CAUTION:
# If your application intentionally keeps generated source
# in Git, remove these rules.


