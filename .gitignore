# ============================================================
# .NET BUILD OUTPUT
# ============================================================

# Build output directories
[Bb]in/
[Oo]bj/

# Common alternative build directories
[Bb]uild/
[Bb]uilds/
[Aa]rtifacts/

# .NET publish output
[Pp]ublish/

# Debug / Release directories
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/


# ============================================================
# RIDER / JETBRAINS
# ============================================================

# Rider project configuration
.idea/

# JetBrains module files
*.iml

# User-specific Rider / ReSharper settings
*.DotSettings.user

# IMPORTANT:
# Do NOT ignore *.sln.DotSettings by default.
# These can contain team-shared Rider/ReSharper settings.

# Example that SHOULD normally be committed:
# MySolution.sln.DotSettings


# ============================================================
# VISUAL STUDIO
# ============================================================

# Visual Studio local workspace
.vs/

# User-specific Visual Studio files
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio temporary files
*.rsuser

# Visual Studio Code
#
# Uncomment this if you don't want shared VS Code config:
# .vscode/


# ============================================================
# NUGET / PACKAGES
# ============================================================

# NuGet package directory
packages/

# NuGet generated packages
*.nupkg
*.snupkg

# NuGet package restore files that may be generated locally
.nuget/

# NuGet package lock backups
packages.lock.json.bak

# Do NOT ignore packages.lock.json automatically.
# It can be useful and should often be committed.


# ============================================================
# TEST RESULTS
# ============================================================

TestResults/
[Tt]est[Rr]esults/

# Visual Studio test output
*.trx

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# xUnit / test runner output
xunit-results/

# BenchmarkDotNet
BenchmarkDotNet.Artifacts/


# ============================================================
# CODE COVERAGE
# ============================================================

coverage/
coverage-results/

# Coverlet
coverage*.json
coverage*.xml
coverage*.info
coverage*.lcov

# Visual Studio coverage
*.coverage
*.coveragexml

# JetBrains dotCover
*.dotCover
dotCover.Output/

# Generic coverage reports
[Cc]overage[Rr]eports/


# ============================================================
# ASP.NET CORE
# ============================================================

# User secrets should NOT live inside the repository anyway,
# but ignore common local secret directories if created.
secrets/
.secrets/

# ASP.NET generated static files
wwwroot/dist/
wwwroot/build/

# Scaffolding / generated temporary content
ScaffoldingReadMe.txt


# ============================================================
# ENVIRONMENT VARIABLES / SECRETS
# ============================================================

.env
.env.local
.env.*.local

# Common environments
.env.development.local
.env.staging.local
.env.production.local
.env.test.local

# Keep templates/examples
!.env.example
!.env.template
!.env.sample

# Generic secret/config overrides
secrets.json
appsettings.Local.json
appsettings.local.json

# Local development appsettings
appsettings.Development.local.json
appsettings.LocalDevelopment.json

# Don't blindly ignore appsettings.Development.json.
#
# It is commonly committed when it contains only
# non-sensitive development defaults.


# ============================================================
# CERTIFICATES / KEYS
# ============================================================

# Private keys / certificates
*.pfx
*.p12
*.key
*.pem

# Be careful with *.crt / *.cer:
# public certificates may legitimately belong in source control.

# *.crt
# *.cer


# ============================================================
# DATABASES
# ============================================================

# SQLite
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# Local database storage
data/
local-db/
local-database/


# ============================================================
# ENTITY FRAMEWORK CORE
# ============================================================

# EF Core migrations SHOULD normally be committed.
#
# DO NOT ignore:
#
# Migrations/
#
# They represent your database schema history.

# Temporary migration scripts
*.migration.sql.tmp


# ============================================================
# LOGS
# ============================================================

[Ll]ogs/
*.log

# ASP.NET / Serilog local logs
logs/
log/

# Diagnostic logs
*.dlog


# ============================================================
# TEMPORARY FILES
# ============================================================

tmp/
temp/
.tmp/
.temp/

*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# Patch reject files
*.rej


